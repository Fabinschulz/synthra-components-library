{
  "name": "@synthra.io/ui-kit",
  "version": "0.3.7",
  "private": false,
  "license": "MIT",
  "author": "Synthra",
  "description": "A framework for building UI components with React and Material-UI",
  "packageManager": "pnpm@9.12.2",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "keywords": [
    "react",
    "material-ui",
    "web-components"
  ],
  "scripts": {
    "build": "rollup -c --bundleConfigAsCjs",
    "lint": "next lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,css,mdx}\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "rollup -c --bundleConfigAsCjs && changeset publish",
    "prepare": "husky"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@hookform/resolvers": "^3.9.1",
    "@mui/material": "^6.2.1",
    "@mui/x-data-grid": "^7.23.3",
    "@storybook/addon-a11y": "^8.4.7",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "husky": "^9.1.7",
    "next": "14.2.14",
    "react-code-input": "^3.10.1",
    "react-hook-form": "^7.54.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.11",
    "@chromatic-com/storybook": "1.9.0",
    "@rocketseat/eslint-config": "^2.2.2",
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@storybook/addon-essentials": "8.3.5",
    "@storybook/addon-interactions": "8.3.5",
    "@storybook/addon-links": "8.3.5",
    "@storybook/addon-onboarding": "8.3.5",
    "@storybook/blocks": "8.3.5",
    "@storybook/nextjs": "8.3.5",
    "@storybook/react": "8.3.5",
    "@storybook/test": "8.3.5",
    "@swc/cli": "0.4.1-nightly.20240914",
    "@swc/core": "^1.10.1",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.14",
    "eslint-plugin-storybook": "^0.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rollup": "^4.29.0",
    "rollup-plugin-css-only": "^4.5.2",
    "rollup-plugin-dts": "^6.1.1",
    "storybook": "8.3.5",
    "storybook-addon-theme-provider": "^0.2.8",
    "typescript": "^5.7.2"
  }
}
