{
  "name": "@synthra.io/ui-kit",
  "version": "0.4.0",
  "private": false,
  "license": "MIT",
  "author": "Synthra",
  "description": "A framework for building UI components with React and Material-UI",
  "packageManager": "pnpm@9.12.2",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "keywords": [
    "react",
    "material-ui",
    "web-components"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && rollup -c --bundleConfigAsCjs",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,json,css,mdx}\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "prepare": "husky"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.9.1",
    "@mui/material": "^9.4.0",
    "@mui/x-data-grid": "^9.14.0",
    "autoprefixer": "^10.6.1",
    "clsx": "^2.1.1",
    "husky": "^9.1.7",
    "next": "16.3.7",
    "react-code-input": "^3.10.1",
    "react-hook-form": "^7.89.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@chromatic-com/storybook": "5.3.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-links": "10.6.1",
    "@storybook/addon-onboarding": "10.6.1",
    "@storybook/nextjs": "10.6.1",
    "@swc/cli": "0.8.1",
    "@swc/core": "^1.16.13",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.7",
    "eslint-plugin-storybook": "^10.6.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rollup": "^4.63.5",
    "rollup-plugin-css-only": "^4.5.5",
    "rollup-plugin-dts": "^6.5.1",
    "storybook": "10.6.1",
    "typescript": "^6.0.3"
  }
}
